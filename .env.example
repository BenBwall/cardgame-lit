# Copy to .env and uncomment only the settings you want to override.
# Development starts a local backend automatically; production needs a hosted server.
# MULTIPLAYER_DEV_URL=http://127.0.0.1:8787
# MULTIPLAYER_PROD_URL=https://cards.example.org
# Shared override (an empty value disables online play):
# MULTIPLAYER_URL=
# Dedicated game server port; also changes the default development URL:
# MULTIPLAYER_PORT=8787
# For manually started backends:
# MULTIPLAYER_HOST=127.0.0.1
# MULTIPLAYER_ORIGINS=http://127.0.0.1:4175,http://localhost:4173
# For a production backend behind a managed HTTPS proxy (e.g. Railway):
# MULTIPLAYER_TLS_MODE=proxy
# Leave TLS_CERT and TLS_KEY unset in proxy mode; the host supplies PORT.
# Direct production TLS remains the default:
# TLS_CERT=/path/to/certificate.pem
# TLS_KEY=/path/to/private-key.pem
